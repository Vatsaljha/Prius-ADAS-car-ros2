    <!-- START / FINISH GATE                                       -->
    <!-- Dashboard lap detector uses approximately x=15.56, y=12 -->
    <!-- The car should approach from the left (positive X).       -->
    <!-- ========================================================= -->
    <model name="start_finish_gate">
      <static>true</static>

      <pose>15.56 12.0 0.061 0 0 0</pose>

      <link name="link">

        <!-- White strip -->
        <visual name="line_white">
          <geometry>
            <box>
              <size>0.35 2.45 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <!-- Black strip -->
        <visual name="line_black">
          <pose>0 0.0 0.003 0 0 0</pose>
          <geometry>
            <box>
              <size>0.37 2.10 0.026</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
